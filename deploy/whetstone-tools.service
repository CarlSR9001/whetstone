[Unit]
Description=Whetstone public verifier tools and Open Promotion Bench
Documentation=https://whetstone.cyberelf.link/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=shankatsu
Group=shankatsu
WorkingDirectory=/opt/whetstone-tools/current
Environment=PYTHONPATH=/opt/whetstone-tools/current/src
EnvironmentFile=-/etc/whetstone-tools/release.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Aggregate metrics plus explicitly published, sanitized Open Promotion Bench
# receipts are the sanctioned writes. StateDirectory is the only writable path
# under ProtectSystem=strict; task contents and answers are never written.
StateDirectory=whetstone-tools
Environment=WHETSTONE_STATE_DIR=/var/lib/whetstone-tools
Environment=WHETSTONE_OPEN_BENCH_LEDGER=/var/lib/whetstone-tools/open_bench_public.jsonl
# Forge-mined adversary graphs (synced there by whetstone-forge). When the
# file exists, minting and grading pools both fold it in: the public exam
# hardens as the forge finds counterexamples, and items stay fair because
# certification and grading share the exact same pool.
Environment=WHETSTONE_FORGE_LIBRARY=/var/lib/whetstone-tools/adversary_library.jsonl
ExecStart=/usr/bin/python3 -m bcv.toolbox_service --host 127.0.0.1 --port 8988
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT
UMask=0077

# The public process is otherwise read-only, unprivileged, loopback-bound, and
# does not load an examiner bank. These restrictions turn those application
# boundaries into operating-system boundaries as well.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
TasksMax=96
CPUQuota=100%

[Install]
WantedBy=multi-user.target
